# Use /api/v1 with the Vite proxy so the CMS also works when opening the site by LAN IP.
# Leave empty to use the built-in frontend content.
VITE_CMS_API_URL=/api/v1

# Optional: provide a trusted LAN certificate and matching private key for Vite HTTPS.
# Example files can be generated with mkcert; keep private keys out of version control.
# VITE_DEV_HTTPS_CERT=local-https-cert.pem
# VITE_DEV_HTTPS_KEY=local-https-key.pem
